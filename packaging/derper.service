[Unit]
Description=DERP (Designated Encrypted Relay for Packets) server
After=network.target

[Service]
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=DOMAIN=derp.example.com
Environment=LISTEN_ADDR=[::]:444
Environment=ARGS='--http-port -1 --verify-clients'
Type=simple
User=derper
Group=derper
ExecStart=/usr/bin/derper -c /etc/derper/derper.conf -a ${LISTEN_ADDR} --hostname ${DOMAIN} ${ARGS}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target 